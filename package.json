{
	"name": "musicview",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/",
		"fmt:check": "oxfmt --check src/",
		"deploy": "opennextjs-cloudflare && wrangler deploy",
		"preview": "opennextjs-cloudflare && wrangler dev",
		"cf-typegen": "wrangler types",
		"cf-typegen:check": "wrangler types --check"
	},
	"dependencies": {
		"next": "16.3.1",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "1.20.2",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"wrangler": "4.124.0"
	}
}
